<?xml version="1.0" encoding="utf-8"?>
<!--
   Data extraction rules for Android 12+ (API 31+) cloud backup & device transfer.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="report_database"/>
        <include domain="database" path="report_database-shm"/>
        <include domain="database" path="report_database-wal"/>
        <include domain="sharedpref" path="."/>
        <include domain="file" path="."/>
        <include domain="external" path="."/>
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="report_database"/>
        <include domain="database" path="report_database-shm"/>
        <include domain="database" path="report_database-wal"/>
        <include domain="sharedpref" path="."/>
        <include domain="file" path="."/>
        <include domain="external" path="."/>
    </device-transfer>
</data-extraction-rules>
