{
  "project_info": {
    "name": "ProjectReporter",
    "package_name": "com.fearmikey.projectreporter",
    "version_name": "1.5.2",
    "version_code": 8,
    "description": "100% FOSS, offline-first Android application for field inspection reports with photo watermarking, rich notes, PDF/Word exports, custom branding, and local backup/restore."
  },
  "architecture": {
    "pattern": "MVVM with Clean Architecture principles",
    "di_framework": "Hilt (Dagger)",
    "async_concurrency": "Kotlin Coroutines & Flow / StateFlow",
    "ui_toolkit": "Jetpack Compose (Material 3)",
    "persistence": "Room Database (SQLite) + DataStore Preferences"
  },
  "rules_and_constraints": {
    "foss_policy": "STRICT 100% FOSS (F-Droid compliance). ZERO proprietary SDKs allowed (no Google Play Services, AdMob, Billing, ML Kit, Firebase binaries, or tracking SDKs).",
    "offline_first": "100% offline functionality; all data stays local on device or in user-managed local ZIP backups.",
    "agent_manifest_maintenance": "Agents MUST update this file (.agent_manifest.json) at the end of each session whenever files or architecture change."
  },
